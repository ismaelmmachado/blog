---
const sections = [
  { title: "Resources", links: ["Tutorials", "Tools", "Agents"] },
  { title: "Community", links: ["Discord", "Twitter", "GitHub"] },
  { title: "Company", links: ["About", "Careers", "Contact"] },
];
---
<footer class="border-t bg-muted/50 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      <div>
        <h4 class="font-semibold text-gray-900 mb-4">superblog</h4>
        <p class="text-muted-foreground text-sm">
          AI agent tutorials, skills, tools, and model benchmarks.
        </p>
      </div>
      {{#each sections}}
      <div>
        <h5 class="font-medium text-gray-900 mb-3">{title}</h5>
        <ul class="space-y-2 text-sm text-muted-foreground">
          {{#each links}}
          <li><a href="#" class="hover:text-primary transition-colors">{.}</a></li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
    <div class="pt-8 border-t border-border/20 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-muted-foreground">
        2026 superblog. All rights reserved.
      </p>
      <div class="flex gap-3">
        {/* Social links would go here */}
      </div>
    </div>
  </div>
</footer>